# Required for all environments: generate a long random value. Never commit the real value.
TAGVEE_SECRET_KEY=replace-with-a-long-random-secret

# Production: set to your Render URL, e.g. https://your-service.onrender.com
TAGVEE_PUBLIC_BASE_URL=https://your-service.onrender.com

# Production database: paste Neon PostgreSQL connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional push notifications: upload private_key.pem to the host as a secret file,
# then set this to its absolute path. Keep the private key out of GitHub.
TAGVEE_VAPID_PRIVATE_KEY_PATH=/etc/secrets/private_key.pem
TAGVEE_VAPID_SUBJECT=mailto:your-real-contact@example.com

# Optional email notifications using Resend HTTPS API (recommended on Render).
TAGVEE_RESEND_API_KEY=re_xxxxxxxxx
TAGVEE_MAIL_FROM=TAGVEE <alerts@your-verified-domain.example>

# Local-only optional SMTP fallback (not available on Render free due to SMTP restrictions).
# TAGVEE_MAIL_SERVER=smtp.gmail.com
# TAGVEE_MAIL_PORT=587
# TAGVEE_MAIL_USE_TLS=true
# TAGVEE_MAIL_USERNAME=your-email@example.com
# TAGVEE_MAIL_PASSWORD=your-app-password

# Optional one-time admin bootstrap (seeds only if username does not already exist).
TAGVEE_ADMIN_USERNAME=
TAGVEE_ADMIN_PASSWORD=

# Optional TURN service credentials. Rotate previously exposed credentials before use.
TAGVEE_TURN_USERNAME=
TAGVEE_TURN_CREDENTIAL=

# Local development override, if needed:
# TAGVEE_COOKIE_SECURE=false
